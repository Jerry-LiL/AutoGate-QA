<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="AutoGate QA Regression Suite" parallel="classes" thread-count="4" verbose="1">
    <listeners>
        <listener class-name="qa.autogate.listeners.TestListener"/>
    </listeners>

    <test name="UI Tests">
        <classes>
            <class name="qa.autogate.tests.ui.LoginUiTest"/>
            <class name="qa.autogate.tests.ui.ProductCatalogUiTest"/>
            <class name="qa.autogate.tests.ui.CheckoutUiTest"/>
        </classes>
    </test>

    <test name="API Tests">
        <classes>
            <class name="qa.autogate.tests.api.AuthApiTest"/>
            <class name="qa.autogate.tests.api.ProductApiTest"/>
            <class name="qa.autogate.tests.api.CartApiTest"/>
            <class name="qa.autogate.tests.api.OrderApiTest"/>
        </classes>
    </test>

    <test name="Database Tests">
        <classes>
            <class name="qa.autogate.tests.db.OrderDatabaseTest"/>
        </classes>
    </test>
</suite>
