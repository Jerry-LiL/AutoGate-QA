    {
      "name": "Products - Get All Products",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Products array contains at least 6 items', function () {",
              "    var items = pm.response.json();",
              "    pm.expect(items).to.be.an('array');",
              "    pm.expect(items.length).to.be.at.least(6);",
              "});",
              "pm.test('Products match array schema', function () {",
              "    var schema = {",
              "        type: 'array',",
              "        items: {",
              "            type: 'object',",
              "            required: ['id', 'name', 'price', 'category', 'stock'],",
              "            properties: {",
              "                id: { type: 'number' },",
              "                name: { type: 'string' },",
              "                price: { type: 'number' },",
              "                category: { type: 'string' },",
              "                stock: { type: 'number' }",
              "            }",
              "        }",
              "    };",
              "    pm.response.to.have.jsonSchema(schema);",
              "});"
            ]
          }
        }
      ]
    },
