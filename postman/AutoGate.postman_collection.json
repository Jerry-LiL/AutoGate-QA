    {
      "name": "Cart - Add Product",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": 1,\n  \"quantity\": 2\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/cart",
          "host": ["{{baseUrl}}"],
          "path": ["api", "cart"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Cart response reflects added items', function () {",
              "    var cart = pm.response.json();",
              "    pm.expect(cart.items).to.be.an('array');",
              "    pm.expect(cart.items.length).to.be.at.least(1);",
              "    pm.expect(cart.totalAmount).to.be.above(0);",
              "});"
            ]
          }
        }
      ]
    },
