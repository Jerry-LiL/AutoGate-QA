    {
      "name": "Orders - Create Order (Chaining)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"shippingAddress\": {\n    \"fullName\": \"Postman Newman Runner\",\n    \"addressLine\": \"100 Automation Street\",\n    \"city\": \"Bengaluru\",\n    \"pincode\": \"560001\"\n  },\n  \"paymentMethod\": \"CARD\",\n  \"items\": [\n    { \"productId\": 1, \"quantity\": 1 },\n    { \"productId\": 3, \"quantity\": 1 }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/orders",
          "host": ["{{baseUrl}}"],
          "path": ["api", "orders"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('Order confirmed with valid ORD- number and saved to environment', function () {",
              "    var order = pm.response.json();",
              "    pm.expect(order.orderNumber).to.match(/^ORD-/);",
              "    pm.expect(order.status).to.eql('CONFIRMED');",
              "    pm.expect(order.shippingCity).to.eql('Bengaluru');",
              "    pm.environment.set('createdOrderId', order.id);",
              "    pm.environment.set('createdOrderNumber', order.orderNumber);",
              "});",
              "pm.test('Order matches json schema', function () {",
              "    var schema = {",
              "        type: 'object',",
              "        required: ['id', 'orderNumber', 'status', 'totalAmount', 'items'],",
              "        properties: {",
              "            id: { type: 'number' },",
              "            orderNumber: { type: 'string' },",
              "            status: { type: 'string' },",
              "            totalAmount: { type: 'number' },",
              "            items: { type: 'array' }",
              "        }",
              "    };",
              "    pm.response.to.have.jsonSchema(schema);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Orders - Get Created Order By ID",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/orders/{{createdOrderId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "orders", "{{createdOrderId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Retrieved order number matches chained orderNumber', function () {",
              "    var order = pm.response.json();",
              "    var expectedOrderNum = pm.environment.get('createdOrderNumber');",
              "    pm.expect(order.orderNumber).to.eql(expectedOrderNum);",
              "    pm.expect(order.status).to.eql('CONFIRMED');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Orders - Pincode Boundary Validation (5 digits)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"shippingAddress\": {\n    \"fullName\": \"Boundary Tester\",\n    \"addressLine\": \"100 Invalid Pincode Rd\",\n    \"city\": \"Bengaluru\",\n    \"pincode\": \"56001\"\n  },\n  \"paymentMethod\": \"CARD\",\n  \"items\": [\n    { \"productId\": 1, \"quantity\": 1 }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/orders",
          "host": ["{{baseUrl}}"],
          "path": ["api", "orders"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 422', function () {",
              "    pm.response.to.have.status(422);",
              "});",
              "pm.test('Error specifies pincode validation failure', function () {",
              "    var err = pm.response.json();",
              "    pm.expect(err.field).to.eql('pincode');",
              "    pm.expect(err.message).to.eql('Pincode must be exactly 6 numeric digits');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Cart - Clear Cart",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/cart",
          "host": ["{{baseUrl}}"],
          "path": ["api", "cart"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Cart is empty after clear', function () {",
              "    var cart = pm.response.json();",
              "    pm.expect(cart.items).to.be.an('array');",
              "    pm.expect(cart.items.length).to.eql(0);",
              "    pm.expect(cart.totalAmount).to.eql(0);",
              "});"
            ]
          }
        }
      ]
    }
